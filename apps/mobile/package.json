{
  "name": "mobile",
  "version": "0.1.0",
  "private": true,
  "description": "The [movies] iPhone app: Expo and Expo Router on the shared SDK.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "export:web": "expo export --platform web",
    "typecheck": "EXPO_NO_TYPESCRIPT_SETUP=1 expo customize tsconfig.json > /dev/null && tsc --noEmit"
  },
  "dependencies": {
    "@expo-google-fonts/geist-mono": "^0.4.3",
    "@expo-google-fonts/inter-tight": "^0.4.2",
    "@expo/metro-runtime": "~58.0.14",
    "@movies/contracts": "workspace:*",
    "@movies/sdk": "workspace:*",
    "convex": "catalog:",
    "effect": "catalog:",
    "expo": "~58.0.13",
    "expo-blur": "~58.0.4",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-font": "~58.0.8",
    "expo-glass-effect": "~58.0.4",
    "expo-image": "~58.0.15",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.22",
    "expo-screen-orientation": "~58.0.3",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.3",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "lucide-react-native": "^1.58.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@movies/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "typescript": "catalog:",
    "vitest": "5.0.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
