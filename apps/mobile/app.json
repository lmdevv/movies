{
  "expo": {
    "name": "[movies]",
    "slug": "movies",
    "scheme": "movies",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#000000",
    "ios": {
      "bundleIdentifier": "dev.lmdevv.movies",
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSLocalNetworkUsageDescription": "[movies] connects to your media server on this network.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-screen-orientation",
      [
        "expo-camera",
        {
          "cameraPermission": "[movies] scans the code another device shows to sign it in.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": true
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/InterTight-Regular.ttf",
            "./assets/fonts/InterTight-Medium.ttf",
            "./assets/fonts/InterTight-SemiBold.ttf",
            "./assets/fonts/InterTight-Bold.ttf",
            "./assets/fonts/InterTight-ExtraBold.ttf",
            "./assets/fonts/GeistMono-Regular.ttf",
            "./assets/fonts/GeistMono-Medium.ttf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          }
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    },
    "icon": "./assets/images/icon.png",
    "updates": {
      "enabled": false
    }
  }
}
