{
  "name": "@lmdevv/movies",
  "version": "0.2.0",
  "description": "Search, play, and manage your self-hosted [movies] library from the command line.",
  "keywords": [
    "agent",
    "cli",
    "jellyfin",
    "media-server",
    "movies",
    "self-hosted"
  ],
  "homepage": "https://github.com/lmdevv/movies#readme",
  "bugs": "https://github.com/lmdevv/movies/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lmdevv/movies.git",
    "directory": "apps/cli"
  },
  "bin": {
    "movies": "dist/movies.js"
  },
  "files": [
    "dist/movies.js",
    "dist/THIRD_PARTY_LICENSES.md",
    "skills"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "build:sea": "node scripts/build-sea.ts",
    "prepack": "node scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "skill:reference": "node scripts/skill-reference.ts",
    "test:stack": "MOVIES_STACK_TESTS=1 vitest run --root ../.. apps/cli/src/stack"
  },
  "devDependencies": {
    "@movies/config": "workspace:*",
    "@movies/contracts": "workspace:*",
    "@movies/sdk": "workspace:*",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "esbuild": "0.28.2",
    "fast-check": "4.10.2",
    "postject": "1.0.0-alpha.6",
    "typescript": "catalog:",
    "uqr": "0.1.3",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
