{
  "name": "@movies/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Effect CLI with JSON output for people and agents, plus the agent skill.",
  "license": "MIT",
  "bin": {
    "movies": "dist/movies.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "type": "module",
  "scripts": {
    "build": "node scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "skill:reference": "node scripts/skill-reference.ts",
    "test:stack": "MOVIES_STACK_TESTS=1 vitest run --root ../.. apps/cli/src/stack"
  },
  "devDependencies": {
    "@movies/config": "workspace:*",
    "@movies/contracts": "workspace:*",
    "@movies/sdk": "workspace:*",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "esbuild": "0.28.2",
    "fast-check": "4.10.2",
    "typescript": "catalog:",
    "uqr": "0.1.3",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
