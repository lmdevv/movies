# Configuration names for compose.yaml. Copy to .env and fill in; never commit .env.
# Anything left empty takes the default in brackets. Every line reaches the media service, so a
# setting from apps/media/README.md that is not listed here can be added too.

# Host folder with your movies and shows, mounted read-only at /media/library.
MOVIES_LIBRARY=
# URL people use for the web app and streams, such as http://nas.tailnet.ts.net:8080.
MOVIES_PUBLIC_URL=
# URL browsers and the CLI use for Convex, such as http://nas.tailnet.ts.net:3210.
CONVEX_PUBLIC_URL=
# Host address the ports listen on. 127.0.0.1 (default) keeps them local; use the host's
# Tailscale address for tailnet access. Do not expose them to the internet.
MOVIES_BIND=
# Ports of the web app and Convex [8080, 3210].
MOVIES_PORT=
CONVEX_PORT=
# User and group the media service runs as; they must be able to read MOVIES_LIBRARY [1000].
PUID=
PGID=
# Time zone [UTC].
TZ=
# Image to run [ghcr.io/lmdevv/movies:latest, the newest release]. Pin a release such as
# ghcr.io/lmdevv/movies:0.1, or use ghcr.io/lmdevv/movies:main for the edge.
MOVIES_IMAGE=

# Optional
# TMDB v3 API key or v4 read access token, for metadata and artwork.
TMDB_API_KEY=
# OTLP/HTTP collector for traces and logs, such as http://otel-collector:4318 (--profile telemetry).
OTEL_EXPORTER_OTLP_ENDPOINT=
# Approved library folders inside the container, comma-separated [/media].
LIBRARY_ROOTS=
# GPU transcoding: auto, qsv, or none [auto]; the render node to use [/dev/dri/renderD128]; and
# the VA-API driver, such as iHD for Intel or radeonsi for AMD [detected].
HARDWARE_ACCELERATION=
QSV_DEVICE=
LIBVA_DRIVER_NAME=
# Simultaneous transcodes [3].
MAX_CONCURRENT_TRANSCODES=
# Seconds before an idle stream is closed [60]; seconds ffmpeg may run ahead of the player [120].
STREAM_IDLE_SECONDS=
STREAM_BUFFER_AHEAD_SECONDS=
# Free space in MiB the transcode volume must keep before a stream starts [2048].
MIN_FREE_TRANSCODE_MB=
# Minutes between full library reconciliations [360].
LIBRARY_RECONCILE_MINUTES=
# Days of nightly backups kept [14].
BACKUP_RETENTION_DAYS=
