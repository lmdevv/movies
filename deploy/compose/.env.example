# Configuration names for compose.yaml. Copy to .env and fill in; never commit .env.
# Anything left empty takes the default in brackets.

# Host folder with your movies and shows, mounted read-only at /media/library.
MOVIES_LIBRARY=
# URL people use for the web app and streams, such as http://nas.tailnet.ts.net:8080.
MOVIES_PUBLIC_URL=
# URL browsers and the CLI use for Convex, such as http://nas.tailnet.ts.net:3210.
CONVEX_PUBLIC_URL=
# Host address the ports listen on. 127.0.0.1 (default) keeps them local; use the host's
# Tailscale address for tailnet access. Do not expose them to the internet.
MOVIES_BIND=
# Ports of the web app and Convex [8080, 3210].
MOVIES_PORT=
CONVEX_PORT=
# User and group the media service runs as; they must be able to read MOVIES_LIBRARY [1000].
PUID=
PGID=
# Time zone [UTC].
TZ=
# Image to run [ghcr.io/lmdevv/movies:latest, the newest release]. Pin a release such as
# ghcr.io/lmdevv/movies:0.1, or use ghcr.io/lmdevv/movies:main for the edge.
MOVIES_IMAGE=

# Optional
# TMDB v3 API key or v4 read access token, for metadata and artwork.
TMDB_API_KEY=
# OMDb API key, for IMDb, Rotten Tomatoes, and Metacritic scores; without it titles keep TMDB's.
OMDB_API_KEY=
# OTLP/HTTP collector for traces and logs, such as http://otel-collector:4318 (--profile telemetry).
OTEL_EXPORTER_OTLP_ENDPOINT=
# Approved library folders inside the container, comma-separated [/media].
LIBRARY_ROOTS=
# GPU transcoding: auto (Quick Sync, then VA-API, then software), qsv, vaapi, or none [auto]; the
# render nodes for Quick Sync and VA-API [/dev/dri/renderD128]; and the VA-API driver, such as
# iHD for Intel or radeonsi for AMD [detected]. For VA-API add compose.vaapi.yaml.
HARDWARE_ACCELERATION=
QSV_DEVICE=
VAAPI_DEVICE=
LIBVA_DRIVER_NAME=
# Simultaneous transcodes [3]; simultaneous remux and audio-only streams [10].
MAX_CONCURRENT_TRANSCODES=
MAX_CONCURRENT_REMUXES=
# Seconds before a quiet stream's encoder stops [60]; seconds ffmpeg may run ahead of the player [120].
STREAM_IDLE_SECONDS=
STREAM_BUFFER_AHEAD_SECONDS=
# Free space in MiB the transcode volume must keep before a stream starts [2048].
MIN_FREE_TRANSCODE_MB=
# Minutes between full library reconciliations [360].
LIBRARY_RECONCILE_MINUTES=
# Scrub thumbnails: on or off [on]; seconds between thumbnails [10]; files made at once [1].
TRICKPLAY=
TRICKPLAY_INTERVAL_SECONDS=
TRICKPLAY_CONCURRENCY=
# How libraries notice changes: auto (events on local disks, polling on NFS, SMB/CIFS, 9p, and
# FUSE shares), events, or poll [auto]; seconds between polls [60].
LIBRARY_WATCH=
LIBRARY_POLL_SECONDS=
# Longest ffprobe probe or artwork resize [60]; longest whole-file scan (keyframes, embedded
# subtitles) [900], in seconds.
PROBE_TIMEOUT_SECONDS=
FILE_SCAN_TIMEOUT_SECONDS=
# Size in MiB the provider, keyframe, subtitle, and artwork caches are pruned to [2048].
CACHE_MAX_MB=
# Days of nightly backups kept [14].
BACKUP_RETENTION_DAYS=
# Retained logs under /data/media/logs, which `movies logs` reads: least severe level kept,
# trace, debug, info, warn, or error [info]; days kept [14]; total size in MiB [512].
LOG_LEVEL=
LOG_RETENTION_DAYS=
LOG_MAX_MB=
