# Configuration names for compose.yaml. Copy to .env and fill in; never commit .env.
# Defaults in compose.yaml apply to anything left empty.

# Host folder with your movies and shows, mounted read-only at /media/library.
MOVIES_LIBRARY=
# URL people use for the web app and streams, such as http://nas.tailnet.ts.net:8080.
MOVIES_PUBLIC_URL=
# URL browsers and the CLI use for Convex, such as http://nas.tailnet.ts.net:3210.
CONVEX_PUBLIC_URL=
# Host address the ports listen on. 127.0.0.1 (default) keeps them local; use the host's
# Tailscale address for tailnet access. Do not expose them to the internet.
MOVIES_BIND=
MOVIES_PORT=
CONVEX_PORT=
# User and group the media service runs as; they must be able to read MOVIES_LIBRARY.
PUID=
PGID=
TZ=
# Image to run; defaults to ghcr.io/lmdevv/movies:main.
MOVIES_IMAGE=

# Optional
TMDB_API_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=
HARDWARE_ACCELERATION=
MAX_CONCURRENT_TRANSCODES=
BACKUP_RETENTION_DAYS=
