{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["tools/oxlint/**"],
  "ignoreDependencies": ["@effect/language-service"],
  "workspaces": {
    ".": {
      "entry": [".agents/skills/*/scripts/*.mjs"]
    },
    "apps/media": {
      "entry": ["src/main.ts", "scripts/*.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts"]
    },
    "apps/web": {},
    "packages/backend": {
      "typescript": {
        "config": ["convex/tsconfig.json"]
      }
    },
    "packages/ui": {},
    "packages/sdk": {},
    "apps/cli": {
      "entry": ["src/main.ts", "scripts/*.ts"]
    }
  }
}
