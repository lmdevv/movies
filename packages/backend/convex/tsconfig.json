{
  /* Convex requires target ESNext, lib ES2021 + dom, module ESNext, isolatedModules, and noEmit. */
  "extends": "@movies/config/tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "jsx": "react-jsx",
    "lib": ["ES2023", "dom"],
    "types": ["node"]
  },
  "include": ["./**/*"],
  "exclude": ["./_generated"]
}
