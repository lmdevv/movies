# Runtime configuration names. Never commit values.

# Convex deployment (local, self-hosted, or cloud) and Convex Auth
CONVEX_SELF_HOSTED_URL=
CONVEX_SELF_HOSTED_ADMIN_KEY=
JWT_PRIVATE_KEY=
JWKS=
SITE_URL=

# Shared HMAC secret for playback tokens, between Convex and the media service. Never sent to clients.
PLAYBACK_TOKEN_SECRET=

# Restricted login the media service uses to subscribe to Convex
MEDIA_SERVICE_API_KEY=

# Client-reachable media endpoint
MEDIA_BASE_URL=

# Metadata plugin
TMDB_API_KEY=

# Paths: approved library mounts (comma-separated), state, temporary HLS output, backups
LIBRARY_ROOTS=
DATA_DIR=
TRANSCODE_DIR=
BACKUP_DIR=/data/backups

# Optional local OpenTelemetry collector
OTEL_EXPORTER_OTLP_ENDPOINT=

# Media service (optional; defaults in apps/media/README.md)
PORT=
WEB_DIST_DIR=
MAX_CONCURRENT_TRANSCODES=
HARDWARE_ACCELERATION=
QSV_DEVICE=
STREAM_IDLE_SECONDS=
MIN_FREE_TRANSCODE_MB=
LIBRARY_RECONCILE_MINUTES=
FFMPEG_PATH=
FFPROBE_PATH=
CONVEX_URL=
